# 服务端口
CERTPILOT_PORT=8080

# MySQL DSN
CERTPILOT_DB_DSN=root:root@tcp(127.0.0.1:3306)/certpilot?charset=utf8mb4&parseTime=True&loc=Local

# JWT 签名密钥（生产环境必须更换）
CERTPILOT_JWT_SECRET=dev-only-secret-change-me

# AES-GCM 主密钥：64 个 hex 字符（32 字节）。
# 生成示例：openssl rand -hex 32
# 用于加密证书私钥、通知渠道凭证等敏感数据
CERTPILOT_MASTER_KEY=

# SMTP 邮件通知（到期提醒）
CERTPILOT_SMTP_HOST=
# 465（SSL，默认）或 587（STARTTLS）
CERTPILOT_SMTP_PORT=465
CERTPILOT_SMTP_USER=
CERTPILOT_SMTP_PASSWORD=
CERTPILOT_SMTP_FROM=
